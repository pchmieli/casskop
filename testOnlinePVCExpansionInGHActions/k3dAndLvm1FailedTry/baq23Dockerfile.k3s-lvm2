# File: `.github/workflows/Dockerfile.k3s-lvm2`
FROM debian:11-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      lvm2 \
      dmsetup \
      libdevmapper-event1.02.1 \
      libdevmapper1.02.1 \
      libblkid1 \
      libaio1 \
      libedit2 \
      libsystemd0 \
      libudev1 \
      udev \
      systemd \
      systemd-sysv \
      kmod \
      util-linux \
      e2fsprogs \
      ca-certificates \
      procps \
      iproute2 \
      iptables \
      libcap2-bin \
      elfutils \
      file \
      curl \
      ; \
    rm -rf /var/lib/apt/lists/*

# Versions: pin k3s for reproducibility
ARG K3S_VERSION=v1.24.13+k3s1
ARG TARGETOS
ARG TARGETARCH
ARG TARGETVARIANT

# Install k3s binary (architecture-aware)
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    # Prefer Docker buildx-provided TARGETARCH when present; otherwise derive from dpkg.
    if [ -n "${TARGETARCH:-}" ]; then \
      arch="${TARGETARCH}"; \
    fi; \
    case "${arch}" in \
      amd64|x86_64) k3s_arch="" ;; \
      arm64|aarch64) k3s_arch="-arm64" ;; \
      armhf|arm/v7|arm) k3s_arch="-armhf" ;; \
      *) echo "Unsupported arch: ${arch}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/k3s \
      "https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION}/k3s${k3s_arch}"; \
    chmod +x /usr/local/bin/k3s; \
    /usr/local/bin/k3s --version

# Create required directories
RUN mkdir -p /var/lib/rancher/k3s /var/lib/kubelet /var/lib/cni /var/log /run /tmp

# Minimal entrypoint (force LF)
RUN set -eux; \
    printf '%s\n' \
      '#!/bin/sh' \
      'set -e' \
      'exec /usr/local/bin/k3s "$@"' \
      > /usr/local/bin/entrypoint.sh; \
    chmod 0755 /usr/local/bin/entrypoint.sh; \
    /bin/sh -n /usr/local/bin/entrypoint.sh

#VOLUME ["/var/lib/rancher/k3s", "/var/lib/kubelet", "/var/lib/cni", "/var/log"]
EXPOSE 6443

# Add k3d-compatible entrypoint path
RUN set -eux; \
    printf '%s\n' \
      '#!/bin/sh' \
      'set -e' \
      'exec /usr/local/bin/k3s server --disable=servicelb --disable=traefik --tls-san=0.0.0.0 "$@"' \
      > /bin/k3d-entrypoint.sh; \
    chmod 0755 /bin/k3d-entrypoint.sh; \
    /bin/sh -n /bin/k3d-entrypoint.sh

ENTRYPOINT ["/bin/sh", "/usr/local/bin/entrypoint.sh"]
CMD ["server"]