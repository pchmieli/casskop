# File: `.github/workflows/Dockerfile.k3s-lvm2`
FROM debian:11-slim

ENV DEBIAN_FRONTEND=noninteractive

# Versions: pin k3s for reproducibility
ARG K3S_VERSION=v1.24.13+k3s1
ARG TARGETARCH=amd64

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      lvm2 \
      dmsetup \
      libdevmapper-event1.02.1 \
      libdevmapper1.02.1 \
      libblkid1 \
      libaio1 \
      libedit2 \
      libsystemd0 \
      libudev1 \
      udev \
      systemd \
      systemd-sysv \
      kmod \
      util-linux \
      e2fsprogs \
      ca-certificates \
      procps \
      iproute2 \
      iptables \
      libcap2-bin \
      elfutils \
      file \
      curl \
      ; \
    rm -rf /var/lib/apt/lists/*

# Install k3s binary
RUN set -eux; \
    curl -fsSL -o /usr/local/bin/k3s \
      "https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION}/k3s"; \
    chmod +x /usr/local/bin/k3s; \
    /usr/local/bin/k3s --version

# Minimal entrypoint compatible with k3d (k3d passes args like: server ...)
RUN set -eux; \
  cat > /usr/local/bin/entrypoint.sh <<'EOF'
#!/bin/sh
set -e
exec /usr/local/bin/k3s "$@"
EOF
RUN chmod +x /usr/local/bin/entrypoint.sh

VOLUME ["/var/lib/rancher/k3s", "/var/lib/kubelet", "/etc/rancher"]
EXPOSE 6443

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["server"]